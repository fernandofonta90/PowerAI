# Variables del entorno de desarrollo (docker compose) en la raíz del monorepo.
# Copia a `.env`. Solo configuración local, sin secretos ni datos reales.
#
# Las credenciales de Postgres en dev son fijas y conocidas (no secretas);
# en producción provienen de Azure Key Vault.

# Puertos de host del entorno dev. Cámbialos si chocan con otros servicios
# locales (p. ej. otro Postgres en 5432 u otro Redis en 6379).
POWERAI_POSTGRES_PORT=5432
POWERAI_REDIS_PORT=6379
