# Configuración de la API de PowerAI (variables con prefijo POWERAI_).
# Copia a `.env` y ajusta. NUNCA pongas valores reales ni secretos aquí.

# Entorno: dev | test | prod
POWERAI_ENTORNO=dev

# Proveedor de autenticación: mock | entra
POWERAI_AUTH_PROVIDER=mock

# PostgreSQL (base transaccional). Driver psycopg v3.
POWERAI_DATABASE_URL=postgresql+psycopg://powerai:powerai_dev@localhost:5432/powerai

# Redis (broker y backend de Celery).
POWERAI_REDIS_URL=redis://localhost:6379/0

# Celery en modo eager (síncrono, sin worker). Solo para tests/CI.
POWERAI_CELERY_EAGER=false

# Azure Blob Storage. Por defecto apunta a Azurite (dev). La clave de Azurite es
# pública y bien conocida (no es un secreto). En prod proviene de Key Vault.
POWERAI_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Proveedor de IA: fake (dev/test) | azure_openai (prod). Capa adapter.
POWERAI_LLM_PROVIDER=fake

# Azure OpenAI (solo si llm_provider=azure_openai). Secretos por Key Vault en prod.
POWERAI_AZURE_OPENAI_ENDPOINT=
POWERAI_AZURE_OPENAI_API_KEY=
POWERAI_AZURE_OPENAI_DEPLOYMENT=
POWERAI_AZURE_OPENAI_API_VERSION=2024-06-01

# Límites del agente analítico.
POWERAI_AGENTE_MAX_ITERACIONES=5
POWERAI_AGENTE_MAX_FILAS=1000
