# Configuración de la API de PowerAI (variables con prefijo POWERAI_).
# Copia a `.env` y ajusta. NUNCA pongas valores reales ni secretos aquí.

# Entorno: dev | test | prod
POWERAI_ENTORNO=dev

# Proveedor de autenticación: mock | entra
POWERAI_AUTH_PROVIDER=mock

# PostgreSQL (base transaccional). Driver psycopg v3.
POWERAI_DATABASE_URL=postgresql+psycopg://powerai:powerai_dev@localhost:5432/powerai

# Redis (broker de Celery; usado en milestones posteriores).
POWERAI_REDIS_URL=redis://localhost:6379/0
