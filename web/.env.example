# Configuración del frontend de PowerAI. Copia a `.env.local`.
# Sin secretos: solo endpoints y flags públicos.

# URL base de la API de PowerAI.
POWERAI_API_URL=http://localhost:8000

# Usuario mock para desarrollo (header X-Mock-User). Coincide con seed_dev.
POWERAI_MOCK_USER=admin.otc@powerai.dev
